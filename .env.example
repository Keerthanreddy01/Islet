# Islet Environment Configuration Template
# Copy this file to .env for local overrides.
# NOTE: Islet runs out-of-the-box without requiring any API keys or paid services.
# Native Windows features (GSMTC media, screen time) run via local system workers.

# Vite Development Server Port (Default: 5173)
VITE_PORT=5173

# Vite Development Server Host (Default: 127.0.0.1)
VITE_HOST=127.0.0.1

# Optional: Enable verbose diagnostic logging in console
# DEBUG=islet:*
