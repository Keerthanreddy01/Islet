{
  "name": "islet",
  "version": "0.1.0",
  "description": "A Dynamic Island-inspired Windows desktop panel.",
  "author": "Keerthan Reddy <keerthan101011@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/Keerthanreddy01/Islet",
  "repository": {
    "type": "git",
    "url": "https://github.com/Keerthanreddy01/Islet.git"
  },
  "main": "dist-electron/main.js",
  "type": "module",
  "scripts": {
    "build:electron": "tsc -p tsconfig.electron.json && node -e \"const fs=require('fs'); fs.copyFileSync('electron/media-worker.ps1', 'dist-electron/media-worker.ps1'); fs.copyFileSync('electron/screentime-worker.ps1', 'dist-electron/screentime-worker.ps1');\"",
    "dev": "npm run build:electron && concurrently -k \"vite --host 127.0.0.1 --port 5173\" \"wait-on http://localhost:5173 && set VITE_DEV_SERVER_URL=http://localhost:5173&& electron .\"",
    "build": "tsc -p tsconfig.json && vite build && npm run build:electron",
    "dist": "npm run build && electron-builder --win nsis",
    "start": "electron .",
    "format": "prettier --write .",
    "lint": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "postinstall": "node scripts/clean-binaries.cjs"
  },
  "dependencies": {
    "lucide-react": "^1.61.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.6.1",
    "concurrently": "^9.1.0",
    "electron": "^45.1.0",
    "electron-builder": "^25.1.8",
    "framer-motion": "^11.11.17",
    "postcss": "^8.5.31",
    "prettier": "^3.3.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.6.3",
    "vite": "^6.0.1",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.islet.desktop",
    "productName": "Islet",
    "compression": "maximum",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "!dist/win-unpacked/**/*",
      "!dist/*.exe",
      "!dist/*.blockmap",
      "dist-electron/**/*",
      "assets/**/*",
      "!assets/installerSidebar.bmp",
      "package.json"
    ],
    "asarUnpack": [
      "dist-electron/*.ps1"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/installerSidebar.bmp",
      "include": "build/installer.nsh",
      "artifactName": "${productName}-Setup-${version}-${arch}.${ext}"
    }
  }
}
